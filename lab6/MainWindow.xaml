<Window x:Class="lab6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab6"
        mc:Ignorable="d"
        Title="Каталог експонатів" Height="650" Width="700" Background="#FDFDFD">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Новий експонат" BorderBrush="#387C44" BorderThickness="1" Margin="0,0,0,10" FontWeight="Bold">
            <Grid Margin="10">
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontWeight" Value="Normal"/>
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Назва:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameTextBox" Height="22" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Автор:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="AuthorTextBox" Height="22" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Кількість заявок:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="CountRequestTextBox" Height="22" Margin="0,0,0,10"/>

                <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="AddButton" Content="Додати експонат" 
                        Background="#387C44" Foreground="White" FontWeight="Bold" Padding="15,5" 
                        HorizontalAlignment="Left" Margin="0,5,0,10" Click="AddButton_Click"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Список експонатів" BorderBrush="#387C44" BorderThickness="1" Margin="0,0,0,10" FontWeight="Bold">
            <DataGrid x:Name="ExhibitsDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" Margin="10" FontWeight="Normal" AlternatingRowBackground="#F9F9F9">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="2*"/>
                    <DataGridTextColumn Header="Кількість заявок" Binding="{Binding Count}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Дії з каталогом" BorderBrush="#387C44" BorderThickness="1" FontWeight="Bold">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                    <Button x:Name="SortButton" Content="Сортувати" Width="90" Margin="5,0,0,0" Padding="5" Click="SortButton_Click" FontWeight="Normal"/>
                    <Button x:Name="RemoveButton" Content="Видалити" Width="90" Margin="5,0,0,0" Padding="5" Click="RemoveButton_Click" FontWeight="Normal"/>
                    <Button x:Name="LoadButton" Content="Завантажити" Width="90" Margin="5,0,0,0" Padding="5" Click="LoadButton_Click" FontWeight="Normal"/>
                    <Button x:Name="SaveButton" Content="Зберегти" Width="90" Margin="5,0,0,0" Padding="5" Click="SaveButton_Click" FontWeight="Normal"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Пошук:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Normal"/>
                    <TextBox x:Name="SearchTextBox" Width="100" Margin="0,0,5,0" Height="25" FontWeight="Normal"/>
                    <Button x:Name="SearchButton" Content="Шукати" Width="70" Margin="0,0,5,0" Padding="5" Click="SearchButton_Click" FontWeight="Normal"/>

                    <Button x:Name="UnikAuthorsButton" Content="Унікальні автори" Width="110" Margin="5,0,0,0" Padding="5" Click="UnikAuthorsButton_Click" FontWeight="Normal"/>
                    <Button x:Name="TopExhibitsButton" Content="Топ-3" Width="60" Margin="5,0,0,0" Padding="5" Click="TopExhibitsButton_Click" FontWeight="Normal"/>
                    <Button x:Name="AverageButton" Content="Середня к-сть" Width="100" Margin="5,0,0,0" Padding="5" Click="AverageButton_Click" FontWeight="Normal"/>
                    <Button x:Name="GroupButton" Content="Групувати" Width="90" Margin="5,0,0,0" Padding="5" Click="GroupButton_Click" FontWeight="Normal"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>